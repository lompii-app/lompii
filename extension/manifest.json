{
  "manifest_version": 3,
  "name": "lompii",
  "version": "0.2.0",
  "description": "Save images, text and page captures to lompii.",
  "permissions": ["contextMenus", "scripting", "storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["pointer.js"], "all_frames": true, "run_at": "document_start" }
  ],
  "action": {
    "default_title": "lompii",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture part of the page"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/menu-16.png", "32": "icons/menu-32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
